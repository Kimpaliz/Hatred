{
  "name": "@dashboard/games-sdk",
  "version": "2.0.0",
  "description": "Dependency-light browser, service and conformance helpers for Dashboard Games v1 and manifest v2.",
  "type": "module",
  "license": "MIT",
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "default": "./src/index.mjs"
    },
    "./browser": {
      "types": "./types/browser.d.ts",
      "default": "./src/browser.mjs"
    },
    "./service": {
      "types": "./types/service.d.ts",
      "default": "./src/service.mjs"
    },
    "./contract": {
      "types": "./types/contract.d.ts",
      "default": "./src/contract.mjs"
    },
    "./verify": {
      "types": "./types/verify.d.ts",
      "default": "./src/verify.mjs"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "dashboard-games-verify": "./bin/dashboard-games-verify.mjs"
  },
  "files": [
    "bin",
    "src",
    "types",
    "README.md"
  ],
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "verify:self": "node ./bin/dashboard-games-verify.mjs --help"
  },
  "dependencies": {
    "yaml": "^2.8.1"
  },
  "publishConfig": {
    "access": "public"
  }
}

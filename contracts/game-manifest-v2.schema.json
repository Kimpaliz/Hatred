{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:dashboard:games:manifest:v2",
  "title": "Dashboard game manifest v2",
  "description": "Verbindlicher Vertrag für neue oder erneut synchronisierte .dashboard/game.yml eines Dashboard-Spiels.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "name",
    "version",
    "apiCompatibility",
    "runtime",
    "capabilities",
    "resources",
    "media"
  ],
  "properties": {
    "schemaVersion": {
      "const": 2
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 63,
      "pattern": "^[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?$"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80
    },
    "summary": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160
    },
    "description": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000
    },
    "version": {
      "type": "string",
      "maxLength": 100,
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-((?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*)(?:\\.(?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*))*))?(?:\\+([0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*))?$"
    },
    "apiCompatibility": {
      "const": "games-v1"
    },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "port",
        "healthPath",
        "versionPath",
        "websocketPath"
      ],
      "properties": {
        "type": {
          "const": "fullstack"
        },
        "port": {
          "type": "integer",
          "minimum": 1024,
          "maximum": 65535
        },
        "healthPath": {
          "$ref": "#/$defs/httpPath"
        },
        "versionPath": {
          "$ref": "#/$defs/httpPath"
        },
        "websocketPath": {
          "$ref": "#/$defs/httpPath"
        }
      }
    },
    "capabilities": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "multiplayer",
        "persistentProgress",
        "achievements",
        "leaderboards"
      ],
      "properties": {
        "multiplayer": {
          "type": "boolean"
        },
        "persistentProgress": {
          "type": "boolean"
        },
        "achievements": {
          "type": "boolean"
        },
        "leaderboards": {
          "type": "boolean"
        }
      }
    },
    "resources": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "cpu",
        "memoryMb",
        "pids"
      ],
      "properties": {
        "cpu": {
          "type": "number",
          "minimum": 0.1,
          "maximum": 2
        },
        "memoryMb": {
          "type": "integer",
          "minimum": 128,
          "maximum": 2048
        },
        "pids": {
          "type": "integer",
          "minimum": 32,
          "maximum": 512
        }
      }
    },
    "media": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "coverPath",
        "heroPath",
        "iconPath"
      ],
      "properties": {
        "coverPath": {
          "$ref": "#/$defs/coverMediaPath"
        },
        "heroPath": {
          "$ref": "#/$defs/heroMediaPath"
        },
        "iconPath": {
          "$ref": "#/$defs/iconMediaPath"
        }
      }
    }
  },
  "$defs": {
    "httpPath": {
      "type": "string",
      "minLength": 2,
      "maxLength": 128,
      "pattern": "^/(?!\\.{1,2}(?:/|$))(?!.*//)(?!.*\\/\\.{1,2}(?:/|$))[A-Za-z0-9][A-Za-z0-9._~!$&'()*+,;=:@/-]*$"
    },
    "coverMediaPath": {
      "type": "string",
      "minLength": 26,
      "maxLength": 200,
      "pattern": "^public/dashboard/cover\\.(?:avif|png|jpe?g|webp)$"
    },
    "heroMediaPath": {
      "type": "string",
      "minLength": 25,
      "maxLength": 200,
      "pattern": "^public/dashboard/hero\\.(?:avif|png|jpe?g|webp)$"
    },
    "iconMediaPath": {
      "type": "string",
      "minLength": 25,
      "maxLength": 200,
      "pattern": "^public/dashboard/icon\\.(?:avif|png|jpe?g|webp)$"
    }
  }
}
